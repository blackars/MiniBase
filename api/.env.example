SUPABASE_URL=https://xyz.supabase.co
# Nuevo (2025+): secret = antes service_role. Empieza por sb_secret_... Solo servidor, jamás al frontend.
SUPABASE_SECRET_KEY=sb_secret_pon-aqui
# Compat legacy:
# SUPABASE_SERVICE_KEY=eyJ...
CLOUDINARY_CLOUD_NAME=tu-cloud
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
CORS_ORIGINS=http://localhost:3000
# Bulk directo (carga semanal en segundos, solo servidor, jamás al frontend):
# Reset en Supabase → Settings → Database. Pooler sa-east-1 verificado.
SUPABASE_DB_PASSWORD=pon-aqui-la-nueva
# Opcional si cambia de región:
# SUPABASE_POOLER_HOST=aws-0-sa-east-1.pooler.supabase.com
# SUPABASE_POOLER_PORT=6543
